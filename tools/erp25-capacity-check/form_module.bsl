#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НачалоГоризонта = Дата(1, 1, 1) Тогда
		НачалоГоризонта = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	Если КонецГоризонта = Дата(1, 1, 1) Тогда
		КонецГоризонта = КонецДня(ДобавитьМесяц(НачалоГоризонта, 3));
	КонецЕсли;

	УчитыватьТекущуюЗанятость = Истина;
	СтатусРасчета = "Выберите документ План производства и нажмите Рассчитать";

	СоздатьИнтерфейс();

КонецПроцедуры

#КонецОбласти

#Область Интерфейс

&НаСервере
Процедура СоздатьИнтерфейс()

	ГруппаПараметры = Элементы.Добавить("ГруппаПараметры", Тип("ГруппаФормы"));
	ГруппаПараметры.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПараметры.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;

	ДобавитьПолеФормы("ПолеПланПроизводства", "ПланПроизводства", "План производства", ГруппаПараметры);
	ДобавитьПолеФормы("ПолеНачалоГоризонта", "НачалоГоризонта", "Начало расчета", ГруппаПараметры);
	ДобавитьПолеФормы("ПолеКонецГоризонта", "КонецГоризонта", "Конец расчета", ГруппаПараметры);
	ДобавитьПолеФормы("ПолеУчитыватьЗанятость", "УчитыватьТекущуюЗанятость", "Учитывать текущую занятость", ГруппаПараметры);

	Команда = ЭтаФорма.Команды.Добавить("Рассчитать");
	Команда.Действие = "Рассчитать";
	Команда.Заголовок = "Рассчитать выполнимость";
	Кнопка = Элементы.Добавить("КнопкаРассчитать", Тип("КнопкаФормы"), ГруппаПараметры);
	Кнопка.ИмяКоманды = "Рассчитать";
	Кнопка.Заголовок = "Рассчитать выполнимость";

	ДобавитьПолеФормы("ПолеСтатусРасчета", "СтатусРасчета", "Статус", Неопределено);

	ТаблицаИтоги = СоздатьТаблицуФормы("ТаблицаИтоги", "Итоги", "Выполнимость плана", Неопределено, 11);
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиНоменклатура", "Итоги.Номенклатура", "Номенклатура");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиКоличество", "Итоги.Количество", "Количество");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиДатаВыпуска", "Итоги.ДатаВыпуска", "Плановый выпуск");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиРасчетноеОкончание", "Итоги.РасчетноеОкончание", "Расчетное окончание");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиСтатус", "Итоги.Статус", "Результат");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиОтклонение", "Итоги.ОтклонениеДней", "Отклонение, дн.");
	ДобавитьКолонкуФормы(ТаблицаИтоги, "ИтогиОграничение", "Итоги.Ограничение", "Ограничение");

	ТаблицаРесурсы = СоздатьТаблицуФормы("ТаблицаРесурсы", "Ресурсы", "Загрузка видов рабочих центров", Неопределено, 10);
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыВРЦ", "Ресурсы.ВидРабочегоЦентра", "Вид РЦ");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыИнтервал", "Ресурсы.ДатаИнтервала", "Интервал");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыДоступно", "Ресурсы.ДоступноЧасов", "Доступно, ч");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыЗанятоСейчас", "Ресурсы.ЗанятоСейчасЧасов", "Уже занято, ч");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыЗанятоПланом", "Ресурсы.ЗанятоПланомЧасов", "План, ч");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыОстаток", "Ресурсы.СвободноПослеЧасов", "Остаток, ч");
	ДобавитьКолонкуФормы(ТаблицаРесурсы, "РесурсыЗагрузка", "Ресурсы.ЗагрузкаПроцент", "Загрузка, %");

	ТаблицаОперации = СоздатьТаблицуФормы("ТаблицаОперации", "Операции", "Последовательность операций", Неопределено, 14);
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииНоменклатура", "Операции.Номенклатура", "Номенклатура");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииЭтап", "Операции.Этап", "Этап");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииОперация", "Операции.Операция", "Операция");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииВРЦ", "Операции.ВидРабочегоЦентра", "Вид РЦ");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииТрудоемкость", "Операции.ТрудоемкостьЧасов", "Трудоемкость, ч");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииНачало", "Операции.РасчетноеНачало", "Начало");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииОкончание", "Операции.РасчетноеОкончание", "Окончание");
	ДобавитьКолонкуФормы(ТаблицаОперации, "ОперацииСтатус", "Операции.Статус", "Статус");

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеФормы(Имя, ПутьКДанным, Заголовок, Родитель)
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Функция СоздатьТаблицуФормы(Имя, ПутьКДанным, Заголовок, Родитель, Высота)
	Таблица = Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = ПутьКДанным;
	Таблица.Заголовок = Заголовок;
	Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Таблица.Высота = Высота;
	Возврат Таблица;
КонецФункции

&НаСервере
Процедура ДобавитьКолонкуФормы(Таблица, Имя, ПутьКДанным, Заголовок)
	Колонка = Элементы.Добавить(Имя, Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = ПутьКДанным;
	Колонка.Заголовок = Заголовок;
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура Рассчитать(Команда)
	ВыполнитьРасчетНаСервере();
КонецПроцедуры

#КонецОбласти

#Область Расчет

&НаСервере
Процедура ВыполнитьРасчетНаСервере()

	Итоги.Очистить();
	Операции.Очистить();
	Ресурсы.Очистить();

	Если Не ЗначениеЗаполнено(ПланПроизводства) Тогда
		СтатусРасчета = "Не выбран документ План производства";
		Возврат;
	КонецЕсли;

	Если КонецГоризонта <= НачалоГоризонта Тогда
		СтатусРасчета = "Конец горизонта должен быть позже начала";
		Возврат;
	КонецЕсли;

	СтатусРасчета = "Чтение плана производства...";

	ТаблицаПлана = ПолучитьСтрокиПлана(ПланПроизводства);
	Если ТаблицаПлана.Количество() = 0 Тогда
		СтатусРасчета = "В документе нет действующих строк продукции";
		Возврат;
	КонецЕсли;

	ТаблицаМощности = ПолучитьМощности(НачалоГоризонта, КонецГоризонта, УчитыватьТекущуюЗанятость);
	ТаблицаМощности.Индексы.Добавить("ВидРабочегоЦентра,ДатаИнтервала");

	СчетчикОпераций = 0;
	Для Каждого СтрокаПлана Из ТаблицаПлана Цикл

		СтрокаИтога = Итоги.Добавить();
		СтрокаИтога.НомерСтроки = СтрокаПлана.НомерСтроки;
		СтрокаИтога.Номенклатура = Строка(СтрокаПлана.Номенклатура);
		СтрокаИтога.Характеристика = Строка(СтрокаПлана.Характеристика);
		СтрокаИтога.Количество = СтрокаПлана.Количество;
		СтрокаИтога.ДатаЗапуска = СтрокаПлана.ДатаЗапуска;
		СтрокаИтога.ДатаВыпуска = СтрокаПлана.ДатаВыпуска;

		Если Не ЗначениеЗаполнено(СтрокаПлана.Спецификация) Тогда
			СтрокаИтога.Статус = "Не рассчитано";
			СтрокаИтога.Ограничение = "Не указана ресурсная спецификация";
			Продолжить;
		КонецЕсли;

		ОперацииСтроки = ПолучитьОперацииСпецификации(СтрокаПлана.Спецификация, СтрокаПлана.Количество);

		Если ОперацииСтроки.Количество() = 0 Тогда
			СтрокаИтога.Статус = "Не рассчитано";
			СтрокаИтога.Ограничение = "Не найдены этапы/маршрутные операции";
			Продолжить;
		КонецЕсли;

		ПредыдущееОкончание = МаксимальнаяДата(НачалоГоризонта, СтрокаПлана.ДатаЗапуска);
		ОшибкаПланирования = "";
		Ограничение = "";

		Для Каждого СтрокаОперации Из ОперацииСтроки Цикл

			СчетчикОпераций = СчетчикОпераций + 1;
			СтрокаОтчета = Операции.Добавить();
			СтрокаОтчета.НомерСтрокиПлана = СтрокаПлана.НомерСтроки;
			СтрокаОтчета.Номенклатура = Строка(СтрокаПлана.Номенклатура);
			СтрокаОтчета.Этап = СтрокаОперации.ЭтапПредставление;
			СтрокаОтчета.НомерЭтапа = СтрокаОперации.НомерЭтапа;
			СтрокаОтчета.Операция = СтрокаОперации.ОперацияПредставление;
			СтрокаОтчета.НомерОперации = СтрокаОперации.НомерОперации;
			СтрокаОтчета.ВидРабочегоЦентра = Строка(СтрокаОперации.ВидРабочегоЦентра);
			СтрокаОтчета.ТрудоемкостьЧасов = Окр(СтрокаОперации.ТрудоемкостьСекунд / 3600, 2);

			Если Не ЗначениеЗаполнено(СтрокаОперации.ВидРабочегоЦентра) Тогда
				СтрокаОтчета.РасчетноеНачало = ПредыдущееОкончание;
				СтрокаОтчета.РасчетноеОкончание = ПредыдущееОкончание;
				СтрокаОтчета.Статус = "Нет ВРЦ";
				ОшибкаПланирования = "Для операции не задан вид рабочего центра";
				Ограничение = СтрокаОперации.ОперацияПредставление;
				Прервать;
			КонецЕсли;

			РезультатРазмещения = РазместитьОперацию(
				ТаблицаМощности,
				СтрокаОперации.ВидРабочегоЦентра,
				ПредыдущееОкончание,
				СтрокаОперации.ТрудоемкостьСекунд);

			СтрокаОтчета.РасчетноеНачало = РезультатРазмещения.Начало;
			СтрокаОтчета.РасчетноеОкончание = РезультатРазмещения.Окончание;
			СтрокаОтчета.Статус = РезультатРазмещения.Статус;

			Если Не РезультатРазмещения.Успех Тогда
				ОшибкаПланирования = РезультатРазмещения.Статус;
				Ограничение = Строка(СтрокаОперации.ВидРабочегоЦентра);
				Прервать;
			КонецЕсли;

			ПредыдущееОкончание = РезультатРазмещения.Окончание;

		КонецЦикла;

		Если ПустаяСтрока(ОшибкаПланирования) Тогда
			СтрокаИтога.РасчетноеОкончание = ПредыдущееОкончание;
			Если ПредыдущееОкончание <= СтрокаПлана.ДатаВыпуска Тогда
				СтрокаИтога.Статус = "Выполним";
				СтрокаИтога.ОтклонениеДней = 0;
				СтрокаИтога.Ограничение = "";
			Иначе
				СтрокаИтога.Статус = "Не выполним";
				СтрокаИтога.ОтклонениеДней = Окр((ПредыдущееОкончание - СтрокаПлана.ДатаВыпуска) / 86400, 1);
				СтрокаИтога.Ограничение = НайтиПоследнийВРЦСтроки(СтрокаПлана.НомерСтроки);
			КонецЕсли;
		Иначе
			СтрокаИтога.Статус = "Не выполним";
			СтрокаИтога.Ограничение = Ограничение + ": " + ОшибкаПланирования;
		КонецЕсли;

	КонецЦикла;

	ЗаполнитьТаблицуРесурсов(ТаблицаМощности);

	Всего = Итоги.Количество();
	Выполнимо = 0;
	Для Каждого СтрокаИтога Из Итоги Цикл
		Если СтрокаИтога.Статус = "Выполним" Тогда
			Выполнимо = Выполнимо + 1;
		КонецЕсли;
	КонецЦикла;

	СтатусРасчета = СтрШаблон(
		"Расчет завершен. Строк плана: %1; выполнимо в срок: %2; операций рассчитано: %3",
		Всего, Выполнимо, СчетчикОпераций);

КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокиПлана(План)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Продукция.НомерСтроки КАК НомерСтроки,
	|	Продукция.Номенклатура КАК Номенклатура,
	|	Продукция.Характеристика КАК Характеристика,
	|	Продукция.Количество КАК Количество,
	|	Продукция.ДатаЗапуска КАК ДатаЗапуска,
	|	Продукция.ДатаВыпуска КАК ДатаВыпуска,
	|	Продукция.Спецификация КАК Спецификация,
	|	Продукция.Полуфабрикат КАК Полуфабрикат
	|ИЗ
	|	Документ.ПланПроизводства.Продукция КАК Продукция
	|ГДЕ
	|	Продукция.Ссылка = &План
	|	И НЕ Продукция.Отменено
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВыпуска,
	|	НомерСтроки";

	Запрос.УстановитьПараметр("План", План);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ПолучитьОперацииСпецификации(Спецификация, КоличествоПлана)

	ТаблицаОпераций = Новый ТаблицаЗначений;
	ТаблицаОпераций.Колонки.Добавить("Этап");
	ТаблицаОпераций.Колонки.Добавить("ЭтапПредставление");
	ТаблицаОпераций.Колонки.Добавить("НомерЭтапа");
	ТаблицаОпераций.Колонки.Добавить("Операция");
	ТаблицаОпераций.Колонки.Добавить("ОперацияПредставление");
	ТаблицаОпераций.Колонки.Добавить("НомерОперации");
	ТаблицаОпераций.Колонки.Добавить("ВидРабочегоЦентра");
	ТаблицаОпераций.Колонки.Добавить("ТрудоемкостьСекунд");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Этапы.Ссылка КАК Этап,
	|	Этапы.Наименование КАК ЭтапПредставление,
	|	Этапы.НомерЭтапа КАК НомерЭтапа,
	|	Операции.Ссылка КАК Операция,
	|	Операции.Наименование КАК ОперацияПредставление,
	|	Операции.НомерОперации КАК НомерОперации,
	|	ВЫБОР
	|		КОГДА Операции.РабочийЦентр ССЫЛКА Справочник.РабочиеЦентры
	|			ТОГДА ВЫРАЗИТЬ(Операции.РабочийЦентр КАК Справочник.РабочиеЦентры).ВидРабочегоЦентра
	|		ИНАЧЕ ВЫРАЗИТЬ(Операции.РабочийЦентр КАК Справочник.ВидыРабочихЦентров)
	|	КОНЕЦ КАК ВидРабочегоЦентра,
	|	Операции.ВремяШтучное КАК ВремяШтучное,
	|	Операции.ВремяШтучноеЕдИзм КАК ВремяШтучноеЕдИзм,
	|	Операции.ВремяПЗ КАК ВремяПЗ,
	|	Операции.ВремяПЗЕдИзм КАК ВремяПЗЕдИзм,
	|	Операции.Количество КАК БазаКоличества
	|ИЗ
	|	Справочник.ЭтапыПроизводства КАК Этапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТехнологическиеОперации КАК Операции
	|		ПО Операции.Владелец = Этапы.МаршрутнаяКарта
	|ГДЕ
	|	Этапы.Владелец = &Спецификация
	|	И НЕ Этапы.ПометкаУдаления
	|	И НЕ Операции.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Этапы.НомерЭтапа,
	|	Операции.НомерОперации";

	Запрос.УстановитьПараметр("Спецификация", Спецификация);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		СтрокаОперации = ТаблицаОпераций.Добавить();
		СтрокаОперации.Этап = Выборка.Этап;
		СтрокаОперации.ЭтапПредставление = Выборка.ЭтапПредставление;
		СтрокаОперации.НомерЭтапа = Выборка.НомерЭтапа;
		СтрокаОперации.Операция = Выборка.Операция;
		СтрокаОперации.ОперацияПредставление = Выборка.ОперацияПредставление;
		СтрокаОперации.НомерОперации = Выборка.НомерОперации;
		СтрокаОперации.ВидРабочегоЦентра = Выборка.ВидРабочегоЦентра;

		БазаКоличества = Выборка.БазаКоличества;
		Если БазаКоличества = 0 Тогда
			БазаКоличества = 1;
		КонецЕсли;

		ШтучноеСекунд = ВремяВСекундах(Выборка.ВремяШтучное, Выборка.ВремяШтучноеЕдИзм);
		ПЗСекунд = ВремяВСекундах(Выборка.ВремяПЗ, Выборка.ВремяПЗЕдИзм);
		СтрокаОперации.ТрудоемкостьСекунд = ПЗСекунд + ШтучноеСекунд * КоличествоПлана / БазаКоличества;
	КонецЦикла;

	Если ТаблицаОпераций.Количество() > 0 Тогда
		Возврат ТаблицаОпераций;
	КонецЕсли;

	// Если детальные маршрутные операции не ведутся - используем потребность этапов по ВРЦ.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Этапы.Ссылка КАК Этап,
	|	Этапы.Наименование КАК ЭтапПредставление,
	|	Этапы.НомерЭтапа КАК НомерЭтапа,
	|	ВидыРЦ.НомерСтроки КАК НомерОперации,
	|	ВидыРЦ.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ВидыРЦ.ВремяРаботы КАК ВремяРаботы,
	|	ВидыРЦ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВидыРЦ.Загрузка КАК Загрузка
	|ИЗ
	|	Справочник.ЭтапыПроизводства КАК Этапы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства.ВидыРабочихЦентров КАК ВидыРЦ
	|		ПО ВидыРЦ.Ссылка = Этапы.Ссылка
	|ГДЕ
	|	Этапы.Владелец = &Спецификация
	|	И НЕ Этапы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Этапы.НомерЭтапа,
	|	ВидыРЦ.НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаОперации = ТаблицаОпераций.Добавить();
		СтрокаОперации.Этап = Выборка.Этап;
		СтрокаОперации.ЭтапПредставление = Выборка.ЭтапПредставление;
		СтрокаОперации.НомерЭтапа = Выборка.НомерЭтапа;
		СтрокаОперации.Операция = Неопределено;
		СтрокаОперации.ОперацияПредставление = "Потребность этапа по ВРЦ";
		СтрокаОперации.НомерОперации = Выборка.НомерОперации;
		СтрокаОперации.ВидРабочегоЦентра = Выборка.ВидРабочегоЦентра;
		КоэффициентЗагрузки = Выборка.Загрузка;
		Если КоэффициентЗагрузки = 0 Тогда
			КоэффициентЗагрузки = 1;
		КонецЕсли;
		СтрокаОперации.ТрудоемкостьСекунд =
			ВремяВСекундах(Выборка.ВремяРаботы, Выборка.ЕдиницаИзмерения) * КоэффициентЗагрузки;
	КонецЦикла;

	Возврат ТаблицаОпераций;

КонецФункции

&НаСервере
Функция ПолучитьМощности(НачалоПериода, КонецПериода, УчитыватьЗанятость)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Доступность.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	Доступность.ДатаИнтервала КАК ДатаИнтервала,
	|	СУММА(
	|		ВЫБОР
	|			КОГДА Доступность.ВидРабочегоЦентра.ВводитьДоступностьДляВидаРЦ
	|				ТОГДА Доступность.ДоступностьПоВидуРЦОборот
	|			ИНАЧЕ Доступность.ДоступностьПоРЦОборот
	|		КОНЕЦ) КАК ДоступноСекунд,
	|	СУММА(Доступность.ЗанятоОборот) КАК ЗанятоСекунд
	|ИЗ
	|	РегистрНакопления.ДоступностьВидовРабочихЦентров.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		ДатаИнтервала МЕЖДУ &НачалоПериода И &КонецПериода) КАК Доступность
	|
	|СГРУППИРОВАТЬ ПО
	|	Доступность.ВидРабочегоЦентра,
	|	Доступность.ДатаИнтервала
	|
	|УПОРЯДОЧИТЬ ПО
	|	Доступность.ВидРабочегоЦентра,
	|	Доступность.ДатаИнтервала";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Таблица = Запрос.Выполнить().Выгрузить();

	Таблица.Колонки.Добавить("ЗанятоСейчасСекунд");
	Таблица.Колонки.Добавить("ЗанятоПланомСекунд");
	Таблица.Колонки.Добавить("СвободноСекунд");

	Для Каждого Строка Из Таблица Цикл
		Если УчитыватьЗанятость Тогда
			Строка.ЗанятоСейчасСекунд = Максимум(0, Строка.ЗанятоСекунд);
		Иначе
			Строка.ЗанятоСейчасСекунд = 0;
		КонецЕсли;
		Строка.ЗанятоПланомСекунд = 0;
		Строка.СвободноСекунд = Максимум(0, Строка.ДоступноСекунд - Строка.ЗанятоСейчасСекунд);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

&НаСервере
Функция РазместитьОперацию(ТаблицаМощности, ВидРабочегоЦентра, НеРанее, ТребуетсяСекунд)

	Результат = Новый Структура("Успех,Начало,Окончание,Статус", Ложь, НеРанее, НеРанее, "");

	Если ТребуетсяСекунд <= 0 Тогда
		Результат.Успех = Истина;
		Результат.Статус = "Нулевая трудоемкость";
		Возврат Результат;
	КонецЕсли;

	Осталось = ТребуетсяСекунд;
	НачалоРазмещения = Неопределено;
	ОкончаниеРазмещения = Неопределено;

	Для Каждого СтрокаМощности Из ТаблицаМощности Цикл

		Если СтрокаМощности.ВидРабочегоЦентра <> ВидРабочегоЦентра Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаМощности.ДатаИнтервала < НеРанее Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаМощности.СвободноСекунд <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НачалоРазмещения = Неопределено Тогда
			НачалоРазмещения = СтрокаМощности.ДатаИнтервала;
		КонецЕсли;

		ИспользоватьСекунд = Минимум(Осталось, СтрокаМощности.СвободноСекунд);
		СтрокаМощности.СвободноСекунд = СтрокаМощности.СвободноСекунд - ИспользоватьСекунд;
		СтрокаМощности.ЗанятоПланомСекунд = СтрокаМощности.ЗанятоПланомСекунд + ИспользоватьСекунд;
		Осталось = Осталось - ИспользоватьСекунд;
		ОкончаниеРазмещения = СтрокаМощности.ДатаИнтервала;

		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если Осталось > 0 Тогда
		Результат.Статус = СтрШаблон("Не хватает мощности: %1 ч.", Окр(Осталось / 3600, 2));
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Начало = НачалоРазмещения;
	Результат.Окончание = ОкончаниеРазмещения;
	Результат.Статус = "Размещено";
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуРесурсов(ТаблицаМощности)

	Для Каждого СтрокаМощности Из ТаблицаМощности Цикл
		Строка = Ресурсы.Добавить();
		Строка.ВидРабочегоЦентра = Строка(СтрокаМощности.ВидРабочегоЦентра);
		Строка.ДатаИнтервала = СтрокаМощности.ДатаИнтервала;
		Строка.ДоступноЧасов = Окр(СтрокаМощности.ДоступноСекунд / 3600, 2);
		Строка.ЗанятоСейчасЧасов = Окр(СтрокаМощности.ЗанятоСейчасСекунд / 3600, 2);
		Строка.ЗанятоПланомЧасов = Окр(СтрокаМощности.ЗанятоПланомСекунд / 3600, 2);
		Строка.СвободноПослеЧасов = Окр(СтрокаМощности.СвободноСекунд / 3600, 2);

		Если СтрокаМощности.ДоступноСекунд > 0 Тогда
			СтрокаРесурса.ЗагрузкаПроцент = Окр(
				(СтрокаМощности.ЗанятоСейчасСекунд + СтрокаМощности.ЗанятоПланомСекунд)
				/ СтрокаМощности.ДоступноСекунд * 100, 1);
		Иначе
			СтрокаРесурса.ЗагрузкаПроцент = 0;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеФункции

&НаСервере
Функция ВремяВСекундах(ЗначениеВремени, ЕдиницаИзмерения)

	Если ЗначениеВремени = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Секунда Тогда
		Возврат ЗначениеВремени;
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Минута Тогда
		Возврат ЗначениеВремени * 60;
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Час Тогда
		Возврат ЗначениеВремени * 3600;
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.День
		Или ЕдиницаИзмерения = Перечисления.ЕдиницыИзмеренияВремени.Сутки Тогда
		Возврат ЗначениеВремени * 86400;
	Иначе
		Возврат ЗначениеВремени * 60;
	КонецЕсли;

КонецФункции

&НаСервере
Функция МаксимальнаяДата(Дата1, Дата2)
	Если Дата2 > Дата1 Тогда
		Возврат Дата2;
	КонецЕсли;
	Возврат Дата1;
КонецФункции

&НаСервере
Функция Максимум(Значение1, Значение2)
	Если Значение1 > Значение2 Тогда
		Возврат Значение1;
	КонецЕсли;
	Возврат Значение2;
КонецФункции

&НаСервере
Функция Минимум(Значение1, Значение2)
	Если Значение1 < Значение2 Тогда
		Возврат Значение1;
	КонецЕсли;
	Возврат Значение2;
КонецФункции

&НаСервере
Функция НайтиПоследнийВРЦСтроки(НомерСтрокиПлана)
	Результат = "";
	Для Каждого СтрокаОперацииОтчета Из Операции Цикл
		Если СтрокаОперацииОтчета.НомерСтрокиПлана = НомерСтрокиПлана
			И Не ПустаяСтрока(СтрокаОперацииОтчета.ВидРабочегоЦентра) Тогда
			Результат = СтрокаОперацииОтчета.ВидРабочегоЦентра;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
